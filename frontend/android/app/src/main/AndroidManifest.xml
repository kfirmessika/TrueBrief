<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Google OAuth completion. Google blocks embedded webviews, so
                sign-in with Google has to leave the app's webview and finish
                in an in-app Custom Tab (see NativeGoogleButton). Supabase's
                PKCE OAuth flow hands the session back via an authorization
                `code` embedded in the redirect URL itself — no shared
                cookies needed — so pointing that redirect at this custom
                scheme lets Android route the Custom Tab's final hop straight
                back into this activity (singleTask above reuses the running
                instance instead of spawning a new one). NativeShell's
                appUrlOpen listener then forwards the code into an in-webview
                navigation to /sso-callback, where
                supabase.auth.exchangeCodeForSession() completes the exchange
                using this webview's own storage — the same one the flow
                started in, not the Custom Tab's.

                NOTE: truebrief://oauth-callback must also be added to the
                Supabase Dashboard's Authentication -> URL Configuration ->
                Redirect URLs allowlist, or Supabase silently drops the
                callback.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="truebrief" android:host="oauth-callback" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
